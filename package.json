{
  "name": "jsx-async-runtime",
  "version": "2.3.0",
  "description": "An asynchronous JSX runtime without dependencies to be used as html template engine.",
  "keywords": [
    "async",
    "engine",
    "html",
    "jsx",
    "node",
    "runtime",
    "ssr",
    "template"
  ],
  "homepage": "https://www.jeasx.dev/jsx",
  "license": "MIT",
  "author": {
    "name": "Maik Jablonski",
    "email": "mail@jeasx.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jeasx/jsx-async-runtime.git"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "jsx-runtime.d.ts",
    "jsx-dev-runtime.d.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "tsc --build --clean",
    "test": "npm --prefix test ci && npm --prefix test run build && npm --prefix test test",
    "bench": "npm --prefix bench ci && npm --prefix bench run build && npm --prefix bench start"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
