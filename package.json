{
  "name": "jsx-async-runtime",
  "version": "2.1.3",
  "description": "An asynchronous JSX runtime without dependencies to be used as html template engine.",
  "keywords": [
    "async",
    "engine",
    "html",
    "jsx",
    "node",
    "runtime",
    "ssr",
    "template"
  ],
  "homepage": "https://www.jeasx.dev/jsx",
  "license": "MIT",
  "author": {
    "name": "Maik Jablonski",
    "email": "mail@jeasx.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jeasx/jsx-async-runtime.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "import": "./dist/jsx-dev-runtime.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "tsc --build --clean"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "7.0.2"
  }
}
