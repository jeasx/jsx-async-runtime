{
  "name": "jsx-async-runtime-test",
  "type": "module",
  "scripts": {
    "build": "tsc && tsc -p tsconfig.jsxdev.json",
    "test": "node --test \"dist/**/*.test.js\"",
    "dev": "npm run build && (tsc --watch & tsc -p tsconfig.jsxdev.json --watch & node --test --watch \"dist/**/*.test.js\" & wait)",
    "clean": "tsc --build --clean && tsc --build --clean tsconfig.jsxdev.json"
  },
  "dependencies": {
    "jsx-async-runtime": "file:.."
  },
  "devDependencies": {
    "@types/node": "file:../node_modules/@types/node",
    "typescript": "file:../node_modules/typescript"
  }
}
