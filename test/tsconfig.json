{
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "rootDir": "src",
    "outDir": "dist",
    "incremental": true,
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "jsx": "react-jsx",
    "jsxImportSource": "jsx-async-runtime"
  },
  "include": ["src"],
  // Compiled for the dev runtime by tsconfig.jsxdev.json.
  "exclude": ["src/jsx-dev"]
}
